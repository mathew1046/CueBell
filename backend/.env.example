# Copy to backend/.env. Never put these secrets in the mobile app.
GNANI_API_KEY=
# Prisma v3 automatically detects any of its 10 supported languages per utterance.
GNANI_LANGUAGE_CODE=indic-auto
# For Malayalam/English priority instead: ml-IN,en-IN (a hint, not a restriction).
# Use indic-auto, NOT auto; alternatively supply 1–4 supported language codes.
# detected_language_code is optional and derived from the final transcript's script.
# OpenAI fallback is explicitly authorized by the latest product request.
# Exact Responses API model ID from your account; do not use an unverified nickname.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Generate a random secret of at least 16 characters; no usable default.
DEMO_ACCESS_CODE=
# Explicit opt-in for no-login demo clients posting {} to /v1/sessions.
# Public anonymous access permits paid-provider usage: require production gateway/
# attestation/account authentication and provider budget restrictions before public use.
ALLOW_APP_SESSIONS=false
ALLOW_INSECURE_LOCAL=false
MAX_SESSIONS=8
SESSION_TTL_SECONDS=14400
CORRECTION_GRACE_SECONDS=1.2
# Setup capture waits through short provider sentence pauses, not the first final.
REQUEST_PAUSE_SECONDS=3.5
REQUEST_TIMEOUT_SECONDS=90
# Hosted Evon has no verified contract here; do not set a guessed URL.
